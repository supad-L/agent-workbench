{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.invalid/contracts/proxy_endpoint.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "proxy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scheme": {
      "type": "string",
      "enum": [
        "http",
        "https",
        "socks5h"
      ]
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9:.][A-Za-z0-9.:-]*$",
      "anyOf": [
        {
          "format": "hostname"
        },
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "credential_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "proxy_id",
    "label",
    "scheme",
    "host",
    "port",
    "enabled",
    "revision"
  ],
  "additionalProperties": false
}
