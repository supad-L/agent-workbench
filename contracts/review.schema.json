{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.invalid/contracts/review.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "needs_revision",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "basis_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "nonblocking"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "claimed_fixed",
              "verified_resolved"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "required_fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "recheck": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "id",
          "basis_id",
          "severity",
          "status",
          "problem",
          "evidence_ref",
          "required_fix",
          "recheck"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "blocks_delivery": {
            "const": false
          }
        },
        "required": [
          "id",
          "text",
          "blocks_delivery"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "blocker_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "attempt_id",
    "plan_version",
    "contract_revision",
    "artifact_hash",
    "verdict",
    "findings",
    "suggestions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "needs_revision"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocker_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "anyOf": [
                {
                  "properties": {
                    "severity": {
                      "const": "nonblocking"
                    }
                  }
                },
                {
                  "properties": {
                    "status": {
                      "const": "verified_resolved"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
