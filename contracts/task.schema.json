{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.invalid/contracts/task.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "role_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "basis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "base_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "write_dirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "patch_only_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "read_paths",
        "write_dirs",
        "patch_only_paths"
      ],
      "additionalProperties": false
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32768
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "verification_profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "verification_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resource_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "max_review_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "plan_version",
    "plan_hash",
    "contract_revision",
    "role_id",
    "objective",
    "requirement_ids",
    "basis_ids",
    "base_commit",
    "environment_id",
    "depends_on",
    "scope",
    "non_goals",
    "verification_profile",
    "verification_hash",
    "resource_keys",
    "max_review_rounds"
  ],
  "additionalProperties": false
}
