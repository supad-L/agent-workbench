{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.invalid/contracts/network_binding.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "account_resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "ui_mode": {
      "type": "string",
      "enum": [
        "system",
        "proxy"
      ]
    },
    "proxy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "account_resource_id",
    "ui_mode",
    "policy_revision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ui_mode": {
            "const": "system"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "proxy_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ui_mode": {
            "const": "proxy"
          }
        }
      },
      "then": {
        "required": [
          "proxy_id"
        ]
      }
    }
  ]
}
