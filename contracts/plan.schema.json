{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.invalid/contracts/plan.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "engineering_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32768
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "verification_profile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "id",
          "requirement_ids",
          "description",
          "verification_profile"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "ordinary_tasks": {
          "const": "automatic"
        },
        "unresolved_questions": {
          "const": "ask_user"
        },
        "product_changes": {
          "const": "user_confirmed"
        }
      },
      "required": [
        "ordinary_tasks",
        "unresolved_questions",
        "product_changes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "version",
    "title",
    "requirements",
    "engineering_constraints",
    "non_goals",
    "acceptance",
    "autonomy"
  ],
  "additionalProperties": false
}
