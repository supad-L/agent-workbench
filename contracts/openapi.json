  "components": {
    "securitySchemes": {
      "HumanSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "User-only identity; never supplied to task containers"
      },
      "TaskCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Task-scoped identity checked with execution epochs; cannot confirm a plan"
      }
    },
    "schemas": {
      "Confirmation": {
        "type": "object",
        "properties": {
