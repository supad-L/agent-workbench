{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.invalid/contracts/verification.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runner_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "test_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "minItems": 1,
        "maxItems": 256,
        "uniqueItems": true
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "candidate_scripts_are_authoritative": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "image_digest",
    "runner_digest",
    "test_bundle_digest",
    "config_digest",
    "argv",
    "acceptance_ids",
    "candidate_scripts_are_authoritative"
  ],
  "additionalProperties": false
}
